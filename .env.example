# QBIZ KHO PRODUCTION V1 — PUBLIC ENVIRONMENT TEMPLATE (GATE 1)
# Strictly Public Client Identifiers — NEVER expose service_role or DB passwords in frontend!

# Supabase Project URL (Public REST/Auth endpoint)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (Browser-safe, restricted by Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-public-anon-key

# Sync Mode: 'local' (offline-first standalone) or 'cloud' (Supabase authenticated sync)
VITE_SYNC_MODE=local

# ==============================================================================
# QBiz Kho — Electronic Invoice (HĐĐT) & MISA meInvoice Sandbox Credentials
# Strictly Server-Side Only — NEVER exposed to client or browser!
# ==============================================================================
# Server-side Gateway JWT secret (required before production deploy)
QBIZ_JWT_SECRET=your_long_random_jwt_secret_min_32_chars

# MISA meInvoice API v3 Endpoints (Default: Sandbox)
MISA_SANDBOX_BASE_URL=https://testapi.meinvoice.vn/api/v3
MISA_AUTH_URL=https://testapi.meinvoice.vn/api/integration/auth/token

# MISA Developer Credentials (obtained from https://developer.misa.vn)
MISA_APP_ID=your_misa_app_id_placeholder
MISA_TAX_CODE=your_test_company_tax_code_placeholder
MISA_USERNAME=your_misa_sandbox_username_placeholder
MISA_PASSWORD=your_misa_sandbox_password_placeholder

# Optional Default Invoice Template & Series Settings
MISA_TEMPLATE_CODE=1
MISA_INVOICE_SERIES=1C26TDC
